# Leave empty to run entirely against deterministic local fixtures.
VITE_API_URL=http://localhost:3001/api

# Force fixture data even when a backend URL is configured.
VITE_USE_FIXTURES=false

# Socket.IO URL for live availability updates. Defaults to the origin of VITE_API_URL.
VITE_SOCKET_URL=http://localhost:3001

# GOOGLE_MAPS_API_KEY.
VITE_GOOGLE_MAPS_API_KEY=