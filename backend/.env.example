# Smart Parking backend — environment template
#
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parkovka

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

CORS_ORIGIN=http://localhost:5173

# --- Payment providers -------------------------------------------------------
# When a provider key is set, that provider's own signature/authentication is
# required on every callback. Leave empty until real credentials exist.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# --- Secure payment test mode ------------------------------------------------
# Only used when the matching provider key above is empty. Callbacks then need
# x-test-signature: sha256=<hmac-sha256(rawBody, PAYMENT_TEST_SECRET)>.
# Refused entirely when NODE_ENV=production.
PAYMENT_TEST_MODE=false
PAYMENT_TEST_SECRET=

# --- Local seed passwords (development only) ---------------------------------
SEED_ADMIN_PASSWORD=
SEED_GUARD_PASSWORD=
SEED_USER_PASSWORD=
